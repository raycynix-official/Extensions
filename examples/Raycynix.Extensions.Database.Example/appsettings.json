{
  "Raycynix": {
    "Serilog": {
      "ServiceName": "raycynix-database-example",
      "Environment": "Development",
      "DefaultConsoleOutputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] [{ServiceName}] [{ServiceVersion}] [Env:{Environment}] {Message:lj}{NewLine}{Exception}"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "DatabaseOptions": {
    "ConnectionOptions": {
      "Name": "raycynix-database-example.db"
    },
    "RetryCount": 3,
    "RetryDelaySeconds": 2,
    "SqliteOptions": {
      "Mode": "ReadWriteCreate",
      "Cache": "Shared",
      "CommandTimeoutSeconds": 30
    },
    "Contexts": {
      "Application": {
        "EnsureCreated": true,
        "UseMigrations": false,
        "EnableSeed": true,
        "EnableLazyLoading": false,
        "EnableAutoDetectChanges": true,
        "UseQueryTrackingByDefault": true
      }
    }
  }
}
