{
  "AllowedHosts": "*",
  "Raycynix": {
    "Serilog": {
      "ServiceName": "raycynix-database-aspnetcore-example"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "DatabaseOptions": {
    "ConnectionOptions": {
      "Name": "raycynix-database-aspnetcore-example.db"
    },
    "RetryCount": 3,
    "RetryDelaySeconds": 2,
    "SqliteOptions": {
      "Mode": "ReadWriteCreate",
      "Cache": "Shared",
      "CommandTimeoutSeconds": 30
    },
    "Contexts": {
      "Application": {
        "EnsureCreated": true,
        "UseMigrations": false,
        "EnableSeed": true,
        "EnableLazyLoading": false,
        "EnableAutoDetectChanges": true,
        "UseQueryTrackingByDefault": true
      }
    }
  }
}
