<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>v3.0.0 migrates optional messaging instrumentation from the removed custom metrics interfaces to standard System.Diagnostics.Metrics counters and histograms with named tags and explicit units.</PackageReleaseNotes>

        <Description>Transport-agnostic messaging, dispatch, direct requests, standard .NET metrics instrumentation, scoped envelopes, and outbox/inbox reliability foundations.</Description>
        <PackageTags>raycynix;messaging;json;grpc;events;integration;outbox;inbox;reliability;observability;metrics;opentelemetry;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Common\Raycynix.Extensions.Common.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Contracts\Raycynix.Extensions.Contracts.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Messaging.Abstractions\Raycynix.Extensions.Messaging.Abstractions.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Metrics.Abstractions\Raycynix.Extensions.Metrics.Abstractions.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Security.Abstractions\Raycynix.Extensions.Security.Abstractions.csproj"/>
    </ItemGroup>

</Project>
