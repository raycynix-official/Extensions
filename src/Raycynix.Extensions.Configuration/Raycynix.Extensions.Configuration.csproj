<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>

        <Description>Core Raycynix typed-options registration for Microsoft.Extensions.Configuration, with dotenv and appsettings sources, named options, feature flags, validation, reload governance, change handlers, diagnostics, and redacted snapshots.</Description>
        <PackageTags>raycynix;configuration;options;typed-options;named-options;section-path;configuration-sources;dotenv;env-file;binding;accessor;feature-flags;validation;reload;diagnostics;redaction;environment;appsettings;dotnet;net10</PackageTags>
        <PackageReleaseNotes>v3.0.0 aligns the package with net10.0/Microsoft.Extensions 10, adds built-in optional .env loading, introduces shared options type-name section path conventions, updates source setup APIs to use ConfigurationSourcesOptions naming, serializes runtime change-handler execution with graceful shutdown cancellation, and documents the current typed options, diagnostics, feature flag, reload, and logging behavior.</PackageReleaseNotes>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="true" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration.Abstractions\Raycynix.Extensions.Configuration.Abstractions.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

</Project>
