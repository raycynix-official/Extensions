<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>

        <PackageReleaseNotes>v3.0.0 replaces SqliteConfiguration with SqliteOptions, binds from DatabaseOptions:SqliteOptions, and validates mode, cache, and command timeout during options resolution.</PackageReleaseNotes>

        <Description>SQLite EF Core integration with typed SqliteOptions, validated mode and cache settings, connection-string composition, and migrations.</Description>
        <PackageTags>raycynix;database;sqlite;provider;options;configuration;provider-validation;efcore;entityframework;migrations;connection-string;embedded-database;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
        <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
    </ItemGroup>

</Project>
