<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>v3.0.0 replaces custom request middleware with stable OpenTelemetry ASP.NET Core instrumentation and standard Microsoft.Extensions.Logging activity tracking scopes.</PackageReleaseNotes>

        <Description>Stable OpenTelemetry ASP.NET Core tracing instrumentation for the shared Raycynix ActivitySource, OTLP exporters, Aspire, and logging correlation.</Description>
        <PackageTags>raycynix;tracing;aspnetcore;opentelemetry;otlp;aspire;http;correlation;activitysource;instrumentation;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Tracing\Raycynix.Extensions.Tracing.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    </ItemGroup>

</Project>
