<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>v3.0.0 adopts DatabaseOptions and ConnectionOptions, binds from DatabaseOptions through the shared configuration pipeline, and preserves fail-fast database registration and initialization validation.</PackageReleaseNotes>

        <Description>Core Raycynix EF Core infrastructure with typed DatabaseOptions, shared and custom DbContext registration, provider validation, initialization, and model discovery.</Description>
        <PackageTags>raycynix;database;efcore;entityframework;options;configuration;dbcontext;custom-context;configurators;model-cache;migrations;assembly-discovery;initialization;provider-validation;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

</Project>
