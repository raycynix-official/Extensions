<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>

        <PackageReleaseNotes>v3.0.0 replaces PostgreSqlConfiguration with PostgreSqlOptions, binds from DatabaseOptions:PostgreSqlOptions, and validates pool ranges and command timeout during options resolution.</PackageReleaseNotes>

        <Description>PostgreSQL EF Core integration with typed PostgreSqlOptions, validated pooling, Npgsql connection-string composition, retries, and migrations.</Description>
        <PackageTags>raycynix;database;postgresql;npgsql;provider;options;configuration;provider-validation;efcore;entityframework;migrations;connection-string;pooling;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
    </ItemGroup>

</Project>
