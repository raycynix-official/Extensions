<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <Description>SQL Server EF Core integration with typed MsSqlServerOptions, validated timeouts, connection-string composition, retries, and migrations.</Description>
        <PackageTags>raycynix;database;sqlserver;mssql;provider;options;configuration;provider-validation;efcore;entityframework;migrations;connection-string;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
        <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.89.0" />
        <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.22.0"/>
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0"/>
        <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.22.0"/>
        <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0"/>
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
        <PackageReference Include="System.Memory.Data" Version="10.0.12" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
        <PackageReference Include="Azure.Core" Version="1.62.0" />
        <PackageReference Include="Azure.Identity" Version="1.21.0"/>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
        <PackageReference Include="Microsoft.Bcl.Cryptography" Version="10.0.12" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
    </ItemGroup>

</Project>
