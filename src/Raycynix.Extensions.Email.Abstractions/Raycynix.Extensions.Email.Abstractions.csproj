<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Hardens email message, attachment, body, header, cancellation, and send-result invariants for the 3.0 contract, including single-copy in-memory attachment snapshots.</PackageReleaseNotes>

        <Description>Provider-neutral email contracts and validated models for message composition, asynchronous attachments, sender implementations, provider registration, and send results.</Description>
        <PackageTags>raycynix;email;abstractions;contracts;sender;provider;message;attachment;mail;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    </ItemGroup>
</Project>
