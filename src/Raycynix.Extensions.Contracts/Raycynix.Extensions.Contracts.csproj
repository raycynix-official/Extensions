<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <Description>Transport-safe shared API contracts for .NET, including semantic contract versions, evolution metadata, paging, money and quantity models, validation errors, and versioned envelopes.</Description>
        <PackageTags>raycynix;contracts;dto;semantic-versioning;contract-versioning;contract-metadata;api;errors;paging;validation;serialization;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

</Project>
