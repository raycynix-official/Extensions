<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>v3.0.0 updates generic-host database initialization for the DatabaseOptions-based 3.0 database contracts.</PackageReleaseNotes>

        <Description>Generic host integration for validated Raycynix database creation and migration initialization through IDatabaseInitializer.</Description>
        <PackageTags>raycynix;database;hosting;generic-host;startup;initialization;migrations;options;workers;services;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

</Project>
