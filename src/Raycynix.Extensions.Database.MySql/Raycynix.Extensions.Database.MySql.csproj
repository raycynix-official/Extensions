<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>

        <PackageReleaseNotes>v3.0.0 replaces MySqlConfiguration with MySqlOptions, binds from DatabaseOptions:MySqlOptions, and validates command timeout during options resolution.</PackageReleaseNotes>

        <Description>MySQL EF Core integration with typed MySqlOptions, validated timeouts, connection-string composition, pooling, retries, and migrations.</Description>
        <PackageTags>raycynix;database;mysql;provider;options;configuration;provider-validation;efcore;entityframework;migrations;connection-string;pooling;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
        <PackageReference Include="System.Security.Permissions" Version="10.0.12" />
        <PackageReference Include="ZstdSharp.Port" Version="0.8.8"/>
        <PackageReference Include="Google.Protobuf" Version="3.36.1" />
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj"/>
        <ProjectReference Include="..\Raycynix.Extensions.Database.Abstractions\Raycynix.Extensions.Database.Abstractions.csproj"/>
    </ItemGroup>
    
</Project>
