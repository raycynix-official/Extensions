<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>v3.0.0 renames database configuration contracts to DatabaseOptions and ConnectionOptions, moves them to the Options namespace, and makes connection settings mutable from setup callbacks.</PackageReleaseNotes>

        <Description>Database contracts and typed options for Raycynix EF Core providers, configurators, initialization, model assembly registration, and observability.</Description>
        <PackageTags>raycynix;database;abstractions;contracts;options;efcore;configurators;providers;provider-validation;configuration;observability;initialization;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    </ItemGroup>

</Project>
