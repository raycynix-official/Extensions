<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.0.0</Version>

        <IsPackable>true</IsPackable>
        <PackageReleaseNotes>Introduces SmtpOptions under EmailOptions:SmtpOptions, streamed attachment composition with deterministic stream disposal, stricter transport and credential validation, and the hardened Email 3.0 message contracts.</PackageReleaseNotes>

        <Description>MailKit-based SMTP provider for Raycynix email with typed transport options, credential and TLS validation, MIME composition, attachments, and asynchronous delivery.</Description>
        <PackageTags>raycynix;email;smtp;mailkit;mail;sender;provider;options;tls;dotnet</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Configuration\Raycynix.Extensions.Configuration.csproj" />
        <ProjectReference Include="..\Raycynix.Extensions.Configuration.Abstractions\Raycynix.Extensions.Configuration.Abstractions.csproj" />
        <ProjectReference Include="..\Raycynix.Extensions.Email\Raycynix.Extensions.Email.csproj" />
        <ProjectReference Include="..\Raycynix.Extensions.Email.Abstractions\Raycynix.Extensions.Email.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" Version="4.18.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    </ItemGroup>
</Project>
